Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Update Topic:
        Value: /map_updates
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Use Timestamp: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      # The LiDAR driver publishes best effort; a reliable subscription would receive nothing.
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.01
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: false
    # Filled only while Nav2 runs (mapping.sh explore or auto); empty in plain manual mapping.
    - Class: rviz_common/Group
      Name: Nav2 and explorer
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Alpha: 0.3
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /global_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
          Update Topic:
            Value: /global_costmap/costmap_updates
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
          Use Timestamp: false
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Alpha: 0.5
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /local_costmap/costmap
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
          Update Topic:
            Value: /local_costmap/costmap_updates
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
          Use Timestamp: false
        - Class: rviz_default_plugins/Path
          Name: Global Plan
          Enabled: true
          Color: 0; 220; 0
          Line Style: Billboards
          Line Width: 0.03
          Alpha: 1
          Topic:
            Value: /plan
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/Path
          Name: Local Plan
          Enabled: true
          Color: 0; 160; 255
          Line Style: Billboards
          Line Width: 0.04
          Alpha: 1
          Topic:
            Value: /local_plan
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/Polygon
          Name: Footprint
          Enabled: true
          Color: 255; 255; 255
          Alpha: 1
          Topic:
            Value: /local_costmap/published_footprint
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/MarkerArray
          Name: Frontiers and goal
          Enabled: true
          Topic:
            Value: /explorer/frontiers
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/MarkerArray
          Name: Geofence
          Enabled: true
          Topic:
            Value: /explorer/geofence
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/InteractiveMarkers
          Name: Handles (geofence, focus, home)
          Enabled: true
          Interactive Markers Namespace: /geofence_handles
          Show Axes: false
          Show Descriptions: false
          Show Visual Aids: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /user_goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 800
  Width: 1100
